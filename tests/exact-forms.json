{
  "description": "ApolloCalc-CAS 共享一致性测试：精确形式。内部模型为三分量 (num/den)·√rad；显示约定：整数 \"3\"、分数 \"1/2\"、纯根式 \"√(2)\" 与 \"2√(2)\"、负号前缀 \"-√(2)\"。混合形式（有理部分+根式，如 (1+√5)/2）不在本表，见 edge-cases.json。",
  "rootOrderInsensitive": true,
  "cases": [
    { "input": "x^2-5x+6=0", "degree": 2, "expectedExact": ["3", "2"] },
    { "input": "x^2-2=0", "degree": 2, "expectedExact": ["√(2)", "-√(2)"] },
    { "input": "x^2-3=0", "degree": 2, "expectedExact": ["√(3)", "-√(3)"] },
    { "input": "x^2-5=0", "degree": 2, "expectedExact": ["√(5)", "-√(5)"] },
    { "input": "x^2=9", "degree": 2, "expectedExact": ["3", "-3"] },
    { "input": "x^2-49=0", "degree": 2, "expectedExact": ["7", "-7"] },
    { "input": "x^2-4x+4=0", "degree": 2, "expectedExact": ["2", "2"] },
    { "input": "2x^2+3x-2=0", "degree": 2, "expectedExact": ["1/2", "-2"] },
    { "input": "3x^2-5x+2=0", "degree": 2, "expectedExact": ["1", "2/3"] },
    { "input": "4x^2-1=0", "degree": 2, "expectedExact": ["1/2", "-1/2"] },
    { "input": "6x^2-x-1=0", "degree": 2, "expectedExact": ["1/2", "-1/3"] },
    { "input": "x^2+2x=0", "degree": 2, "expectedExact": ["0", "-2"] }
  ]
}
