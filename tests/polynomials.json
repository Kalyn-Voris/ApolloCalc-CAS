{
  "description": "ApolloCalc-CAS 共享一致性测试：多项式方程数值求根。expectedRoots 为 [re, im] 数对，按多重集合匹配（顺序无关），容差 per-case。",
  "rootOrderInsensitive": true,
  "cases": [
    { "input": "x^2-5x+6=0", "degree": 2, "expectedRoots": [[3, 0], [2, 0]], "tolerance": 1e-9 },
    { "input": "x^2+1=0", "degree": 2, "expectedRoots": [[0, 1], [0, -1]], "tolerance": 1e-9 },
    { "input": "x^2=9", "degree": 2, "expectedRoots": [[3, 0], [-3, 0]], "tolerance": 1e-9 },
    { "input": "x^2-4x+4=0", "degree": 2, "expectedRoots": [[2, 0], [2, 0]], "tolerance": 1e-9 },
    { "input": "2x^2+3x-2=0", "degree": 2, "expectedRoots": [[0.5, 0], [-2, 0]], "tolerance": 1e-9 },
    { "input": "x^2+2x+5=0", "degree": 2, "expectedRoots": [[-1, 2], [-1, -2]], "tolerance": 1e-9 },
    { "input": "3x^2-5x+2=0", "degree": 2, "expectedRoots": [[1, 0], [0.6666666666666666, 0]], "tolerance": 1e-9 },
    { "input": "x^2+x-12=0", "degree": 2, "expectedRoots": [[3, 0], [-4, 0]], "tolerance": 1e-9 },
    { "input": "x^2-4x+13=0", "degree": 2, "expectedRoots": [[2, 3], [2, -3]], "tolerance": 1e-9 },
    { "input": "x^2-2x-1=0", "degree": 2, "expectedRoots": [[2.414213562373095, 0], [-0.41421356237309515, 0]], "tolerance": 1e-9 },
    { "input": "x^2-6x+9=0", "degree": 2, "expectedRoots": [[3, 0], [3, 0]], "tolerance": 1e-9 },
    { "input": "x^2=2x+3", "degree": 2, "expectedRoots": [[3, 0], [-1, 0]], "tolerance": 1e-9 },
    { "input": "x^3-6x^2+11x-6=0", "degree": 3, "expectedRoots": [[1, 0], [2, 0], [3, 0]], "tolerance": 1e-9 },
    { "input": "x^3=8", "degree": 3, "expectedRoots": [[2, 0], [-1, 1.7320508075688772], [-1, -1.7320508075688772]], "tolerance": 1e-9 },
    { "input": "x^3-6x^2+12x-8=0", "degree": 3, "expectedRoots": [[2, 0], [2, 0], [2, 0]], "tolerance": 1e-9 },
    { "input": "x^3-3x=0", "degree": 3, "expectedRoots": [[1.7320508075688772, 0], [0, 0], [-1.7320508075688772, 0]], "tolerance": 1e-9 },
    { "input": "2x^3-x-1=0", "degree": 3, "expectedRoots": [[1, 0], [-0.5, 0.5], [-0.5, -0.5]], "tolerance": 1e-9 },
    { "input": "x^3-1=0", "degree": 3, "expectedRoots": [[1, 0], [-0.5, 0.8660254037844386], [-0.5, -0.8660254037844386]], "tolerance": 1e-9 },
    { "input": "x^3+x^2+x+1=0", "degree": 3, "expectedRoots": [[-1, 0], [0, 1], [0, -1]], "tolerance": 1e-9 },
    { "input": "x^4-5x^2+4=0", "degree": 4, "expectedRoots": [[1, 0], [-1, 0], [2, 0], [-2, 0]], "tolerance": 1e-9 },
    { "input": "x^4-1=0", "degree": 4, "expectedRoots": [[1, 0], [-1, 0], [0, 1], [0, -1]], "tolerance": 1e-9 },
    { "input": "x^4-10x^3+35x^2-50x+24=0", "degree": 4, "expectedRoots": [[1, 0], [2, 0], [3, 0], [4, 0]], "tolerance": 1e-7 },
    { "input": "x^4+5x^2+4=0", "degree": 4, "expectedRoots": [[0, 1], [0, -1], [0, 2], [0, -2]], "tolerance": 1e-9 },
    { "input": "2x^4-x^3-14x^2-5x+6=0", "degree": 4, "expectedRoots": [[0.5, 0], [3, 0], [-2, 0], [-1, 0]], "tolerance": 1e-7 },
    { "input": "x^4-4x^3+6x^2-4x+1=0", "degree": 4, "expectedRoots": [[1, 0], [1, 0], [1, 0], [1, 0]], "tolerance": 1e-9 },
    { "input": "x^4+4=0", "degree": 4, "expectedRoots": [[1, 1], [1, -1], [-1, 1], [-1, -1]], "tolerance": 1e-9 }
  ]
}
